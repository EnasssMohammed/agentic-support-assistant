# Copy this file to .env and fill in your own values. Never commit .env itself.

# "ollama" (local, free, no key needed) or "openai" (cloud, needs OPENAI_API_KEY)
MODEL_PROVIDER=ollama

# Model name for the chosen provider.
# Ollama examples: llama3.2:1b, llama3:8b
# OpenAI examples: gpt-4o-mini, gpt-4o
MODEL_NAME=llama3.2:1b

# Only required if MODEL_PROVIDER=openai
OPENAI_API_KEY=

# Where escalation tickets are written (default: ./tickets)
VELO_TICKETS_DIR=tickets

# Optional retrieval relevance cutoff (lower distance = closer match).
# Leave empty to disable; calibrate on your eval set before enabling.
VELO_MAX_DISTANCE=

# Set to 1 to show internal error details in the web UI. Never enable in production.
VELO_DEBUG=0
